# 复制为 .env 后填写。宝塔 PM2 启动时会自动读取本目录下的 .env。

# 服务监听端口（Nginx 反代到这个端口）
PORT=3000

# 后台管理口令（必填）。访问 /admin 时输入。请改成一串长随机字符。
ADMIN_TOKEN=change-me-to-a-long-random-string

# SQLite 数据库文件路径（相对 backend/ 目录）
DB_PATH=./data/waystone.db

# 站点公开地址（用于回链判定与邮件文案）
SITE_URL=https://waystoneai.online

# 回链目标域名：免费档工具站需放置指向该域名的链接
BACKLINK_DOMAIN=waystoneai.online

# 回链校验周期（cron 表达式，默认每 6 小时）
CHECK_CRON=0 */6 * * *

# 回链缺失宽限天数：首次发现缺失后 N 天内标记 grace，超过标记 missing
GRACE_DAYS=7

# 落地页静态目录（相对 backend/ 目录；Nginx 直接托管时可忽略）
STATIC_DIR=../预售落地页

# ---------- 站长通知（群机器人 webhook） ----------
# 有人提交后即时推送到你的群。留空则不通知。
# 飞书：群设置 → 群机器人 → 自定义机器人，复制 webhook 地址
ADMIN_NOTIFY_WEBHOOK_URL=
# 机器人类型：feishu | dingtalk | wecom
ADMIN_NOTIFY_TYPE=feishu

# ---------- 提交人确认邮件（Resend） ----------
# Resend 控制台创建 API Key：https://resend.com/api-keys
# 留空则不发确认邮件。
RESEND_API_KEY=
# 发件地址。需在 Resend 验证你的域名（waystoneai.online）后使用，
# 例如：waystone ai <no-reply@waystoneai.online>
EMAIL_FROM=
